rules_version = '2';

// ============================================================
// WELP FIRESTORE RULES — v15.1
// Perubahan vs v15:
//   • licenses.delete kini DIIZINKAN hanya untuk akun developer
//     pada DAFTAR ALLOWLIST (email + WAJIB email_verified).
//     Sesi anonim app user tidak punya email → tetap tidak bisa
//     menghapus apa pun. email_verified mencegah orang lain
//     mendaftar akun dengan email developer yang sama lalu
//     mewarisi hak hapus.
//   • Selebihnya identik dengan v15 (F0 Identity & Rules).
// CATATAN: pemetaan per-user (role/branch per uid) menyusul
// bersama custom claims (Cloud Functions). Rules ini memblokir
// akses tanpa sesi; isolasi antar-tenant tetap mengandalkan
// licenseId rahasia + permission layer aplikasi (F3).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Developer console (?dev=panel): sesi Email/Password asli
    // milik developer. Tambahkan email dev baru ke daftar di bawah.
    function isDev() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['shandikazaid@gmail.com'];
    }

    // Lisensi — dibaca app saat login & monitoring; tidak publik.
    // Kredensial owner tersimpan hash (credPass/credPin).
    // Hapus tenant: hanya developer terverifikasi (rules v15.1).
    match /licenses/{lic} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isDev();
    }

    // Heartbeat/log sesi — append-only, tidak bisa dibaca/diubah klien.
    match /logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Seluruh data tenant (cabang, karyawan, absensi, payroll,
    // pengajuan, stations, pengaturan, dokumen, audit_log,
    // self_orders, meja_sessions, + koleksi komersial v15).
    match /tenants/{lic}/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
