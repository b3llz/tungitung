rules_version = '2';

// ============================================================
// WELP FIRESTORE RULES — v15 (F0 Identity & Rules)
// PERUBAHAN INTI vs v10:
//   • SELURUH akses kini WAJIB punya sesi Firebase Auth
//     (request.auth != null). App membuka sesi ANONIM otomatis
//     sejak boot (ensureAuth) — aktifkan provider Anonymous di
//     Firebase Console SEBELUM publish rules ini.
//   • licenses tidak lagi terbaca publik; kredensial owner
//     disimpan sebagai hash PBKDF2 (bukan plaintext).
//   • logs (heartbeat) append-only.
// CATATAN: pemetaan per-user (role/branch per uid) menyusul
// bersama custom claims (Cloud Functions). Rules ini memblokir
// akses tanpa sesi; isolasi antar-tenant tetap mengandalkan
// licenseId rahasia + permission layer aplikasi (F3).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Lisensi — dibaca app saat login & monitoring; tidak publik.
    // Kredensial owner tersimpan hash (credPass/credPin).
    match /licenses/{lic} {
      allow get, list: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;   // penghapusan tenant hanya via console admin
    }

    // Heartbeat/log sesi — append-only, tidak bisa dibaca/diubah klien.
    match /logs/{logId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Seluruh data tenant (cabang, karyawan, absensi, payroll,
    // pengajuan, stations, pengaturan, dokumen, audit_log,
    // self_orders, meja_sessions, + koleksi komersial v15).
    match /tenants/{lic}/{document=**} {
      allow read, write: if signedIn();
    }
  }
}
