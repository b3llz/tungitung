rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function appChecked() { return request.app != null; }

    match /tenants/{lic}/absensi/{allPaths=**} {
      allow read: if signedIn() && appChecked();
      allow write: if signedIn() && appChecked()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /tenants/{lic}/{allPaths=**} {
      allow read: if signedIn() && appChecked();
      allow write: if signedIn() && appChecked()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      // Client-side deletion is disabled. Destructive media cleanup should be
      // performed by a trusted backend/admin workflow.
      allow delete: if false;
    }
  }
}
