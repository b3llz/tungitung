rules_version = '2';

// ============================================================
// WELP STORAGE RULES — v15 (F5/J3: media besar ke Storage)
// Foto absensi & dokumen perusahaan diunggah ke tenants/{lic}/...
// App OTOMATIS fallback ke base64 inline bila Storage belum aktif —
// rules ini opsional tapi disarankan agar hemat kuota Firestore.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {
    // Seluruh media tenant: wajib sesi Firebase Auth (sesuai rules
    // Firestore v15). Sesi anonim dari app sudah memenuhi syarat ini.
    match /tenants/{lic}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024   // maks 5MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if request.auth != null;
    }
  }
}
