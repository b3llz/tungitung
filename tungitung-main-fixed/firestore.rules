rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // WELP (tungitung) — FIRESTORE SECURITY RULES v10
    // ------------------------------------------------------------
    // CARA PAKAI:
    //   Firebase Console → Firestore Database → Rules →
    //   tempel seluruh isi file ini → Publish.
    // GANTI email di bawah dengan email akun developer kamu
    // (akun yang dipakai login di God Panel / ?dev=panel).
    // ============================================================

    // === GANTI dengan email akun developer kamu (boleh lebih dari satu) ===
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'diazshandikaf@gmail.com'
      ];
    }

    // Lisensi harus ada & aktif agar data operasional boleh lewat.
    function licActive(lic) {
      return exists(/databases/$(database)/documents/licenses/$(lic))
        && get(/databases/$(database)/documents/licenses/$(lic)).data.active == true;
    }

    // ------------------------------------------------------------
    // KOLEKSI LISENSI / TENANT
    // ------------------------------------------------------------
    match /licenses/{id} {
      // App (login, verifikasi PIN/owner, absensi) membaca SATU dokumen by ID.
      allow get: if true;
      // Hanya developer boleh melihat SELURUH daftar (cegah dump massal).
      allow list: if isAdmin();
      // CRUD lisensi: HANYA developer.
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // LOG AKTIVITAS LOGIN
    // ------------------------------------------------------------
    match /logs/{logId} {
      allow create: if true;                       // app boleh menulis log
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------
    // DATA OPERASIONAL TENANT  (BARU v10)
    // tenants/{lic}/cabang        — Manajemen Cabang (nama, lokasi,
    //                               GPS, password+PIN login, aturan absensi)
    // tenants/{lic}/karyawan      — Manajemen Karyawan (nama, role, cabang)
    // tenants/{lic}/absensi       — Absensi karyawan (selfie, GPS, waktu
    //                               server serverTimestamp, status telat)
    // tenants/{lic}/payroll       — Penggajian (bukti transfer, slip, history)
    // tenants/{lic}/self_orders   — Pesanan self-order pelanggan (meja)
    // tenants/{lic}/meja_sessions — Sesi meja ber-token (anti-fraud 1 device)
    // ------------------------------------------------------------
    match /tenants/{lic} {
      // Semua subcollection di bawah tenant: boleh dibaca/ditulis
      // selama lisensinya ada dan AKTIF. Suspend lisensi = semua
      // perangkat cabang/pelanggan otomatis kehilangan akses.
      match /{document=**} {
        allow read: if licActive(lic);
        allow create, update: if licActive(lic);
        allow delete: if licActive(lic) || isAdmin();
      }
    }

    // Tutup semua koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
